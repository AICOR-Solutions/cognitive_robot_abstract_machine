<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="panel_with_sideways_M">

<!-- Reusable angle parameter -->
    <xacro:property name="m_angle_deg" value="10"/>
  <xacro:property name="init_height_segment" value="0.3"/>
  <xacro:property name="size" value="0.7"/>

  <xacro:property name="m_angle_deg" value="3"/>
  <xacro:property name="init_height_segment" value="0.2"/>

  <xacro:property name="m_angle_deg" value="5"/>
  <xacro:property name="init_height_segment" value="0.2"/>

  <xacro:property name="m_angle_rad" value="${radians(m_angle_deg)}"/>

  <xacro:property name="size" value="0.7"/>

  <!-- Light brown material (tweak rgb if you want) -->
  <material name="m_light_brown">
    <color rgba="0.76 0.60 0.42 1.0"/> <!-- light brown -->
  </material>

  <!-- ===== World and panel ===== -->
  <link name="world_panel"/>

  <link name="column_link">
  <visual>
      <geometry>
        <box size="0.1 0.1 0.5"/>
      </geometry>
      <material name="panel_gray">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.5"/>
      </geometry>
    </collision>
  </link>

<joint name="world_to_column" type="fixed">
    <parent link="world_panel"/>
    <child link="column_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
</joint>

  <link name="panel_link">
    <visual>
      <geometry>
        <box size="0.8 0.8 0.05"/>
      </geometry>
      <material name="panel_gray">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1.0 1.0 0.05"/>
      </geometry>
    </collision>
  </link>

<link name="dummy_link"/>

  <joint name="column_to_dummy" type="fixed">
    <parent link="column_link"/>
    <child link="dummy_link"/>
    <origin xyz="0 0.05 0.25" rpy="-1.2 0 0"/>
  </joint>

  <joint name="column_to_panel" type="revolute">
    <parent link="dummy_link"/>
    <child link="panel_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0"  upper="3.5" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- ===== Sideways-M: 4 thin segments ===== -->
  <!-- Segment geometry -->

  <link name="seg_top">
    <visual>
    <origin xyz="-0.35 0 0" rpy="0 0 0"/>   <!-- if L=0.70 -->
    <geometry><box size="${size} 0.02 0.10"/></geometry>
    <material name="m_light_brown"/>
  </visual>
  <collision>
    <origin xyz="-0.35 0 0" rpy="0 0 0"/>
    <geometry><box size="${size} 0.02 0.10"/></geometry>
  </collision>
  </link>

  <link name="seg_mid_up">
    <visual>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>   <!-- if L=0.70 -->
    <geometry><box size="${size} 0.02 0.10"/></geometry>
    <material name="m_light_brown"/>
  </visual>
  <collision>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
    <geometry><box size="${size} 0.02 0.10"/></geometry>
  </collision>
  </link>

  <link name="seg_mid_down">
    <visual>
    <origin xyz="-0.35 0 0" rpy="0 0 0"/>   <!-- if L=0.70 -->
    <geometry><box size="${size} 0.02 0.10"/></geometry>
    <material name="m_light_brown"/>
  </visual>
  <collision>
    <origin xyz="-0.35 0 0" rpy="0 0 0"/>
    <geometry><box size="${size} 0.02 0.10"/></geometry>
  </collision>
  </link>

  <link name="seg_bottom">
    <visual>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>   <!-- if L=0.70 -->
    <geometry><box size="${size} 0.02 0.10"/></geometry>
    <material name="m_light_brown"/>
  </visual>
  <collision>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
    <geometry><box size="${size} 0.02 0.10"/></geometry>
  </collision>
  </link>



  <!-- Top segment: from right-top toward left-up -->
  <joint name="panel_to_seg_top" type="fixed">
    <parent link="panel_link"/>
    <child link="seg_top"/>
    <origin xyz="0.35 ${init_height_segment} 0.075" rpy="0 0 ${m_angle_rad}"/>
  </joint>

  <!-- Upper middle segment: from left-top down to right-middle -->
  <joint name="panel_to_seg_mid_up" type="fixed">
    <parent link="seg_top"/>
    <child link="seg_mid_up"/>
    <origin xyz="-0.7 -0.05 0.0" rpy="0 0 -${2* m_angle_rad}"/>
  </joint>

  <!-- Lower middle segment: from left-bottom up to right-middle -->
  <joint name="panel_to_seg_mid_down" type="fixed">
    <parent link="seg_mid_up"/>
    <child link="seg_mid_down"/>
    <origin xyz="0.7 -0.05 0" rpy="0 0 ${2* m_angle_rad}"/>
  </joint>

  <!-- Bottom segment: from left-bottom toward right-down -->
  <joint name="panel_to_seg_bottom" type="fixed">
    <parent link="seg_mid_down"/>
    <child link="seg_bottom"/>
    <origin xyz="-0.7 -0.05 0" rpy="0 0 -${2* m_angle_rad}"/>
  </joint>

</robot>
